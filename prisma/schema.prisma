generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String              @id @default(uuid()) @db.Uuid
  email                    String              @unique
  passwordHash             String
  role                     String              @default("cliente")
  isVerified               Boolean             @default(false)
  verificationToken        String?
  recoveryToken            String?
  isSuspended              Boolean             @default(false)
  createdAt                DateTime            @default(now())
  businessName             String?
  businessPhone            String?
  resetToken               String?
  resetTokenExpiry         DateTime?
  telnyxApiKeyEncrypted    String?
  telnyxChildAccountId     String?
  telnyxProvisioningError  String?
  telnyxProvisioningStatus String              @default("none")
  affiliateId              String?             @db.Uuid
  installationAmount       Decimal?            @db.Decimal(10, 2)
  installationPaid         Boolean             @default(false)
  installationPaidAt       DateTime?
  appointments             Appointment[]
  settings                 BusinessSettings?
  metrics                  CallMetric[]
  recordings               CallRecording[]
  transcripts              CallTranscript[]
  endCustomers             EndCustomer[]
  phoneNumbers             PhoneNumber[]
  affiliate                Affiliate?          @relation(fields: [affiliateId], references: [id])
  wallet                   Wallet?
  transactions             WalletTransaction[]

  @@map("users")
}

model BusinessSettings {
  userId                 String   @id @db.Uuid
  aiLanguage             String   @default("es")
  bookingMode            String   @default("hours")
  defaultDurationMinutes Int      @default(30)
  checkInTime            String   @default("15:00")
  checkOutTime           String   @default("11:00")
  businessHours          Json     @default("{\"lunes\": {\"fin\": \"18:00\", \"inicio\": \"09:00\", \"abierto\": true}, \"jueves\": {\"fin\": \"18:00\", \"inicio\": \"09:00\", \"abierto\": true}, \"martes\": {\"fin\": \"18:00\", \"inicio\": \"09:00\", \"abierto\": true}, \"sabado\": {\"fin\": \"14:00\", \"inicio\": \"09:00\", \"abierto\": true}, \"domingo\": {\"fin\": null, \"inicio\": null, \"abierto\": false}, \"viernes\": {\"fin\": \"18:00\", \"inicio\": \"09:00\", \"abierto\": true}, \"miercoles\": {\"fin\": \"18:00\", \"inicio\": \"09:00\", \"abierto\": true}}")
  modo247                Boolean  @default(false)
  timezone               String   @default("America/Mexico_City")
  grabacionActiva        Boolean  @default(false)
  mensajeConsentimiento  String   @default("Esta llamada puede ser grabada para fines de calidad.")
  consentimientoActivo   Boolean  @default(false)
  formFields             Json     @default("[{\"key\": \"nombre\", \"type\": \"text\", \"label\": \"Nombre completo\", \"required\": true}]")
  systemPromptContext    String   @default("Eres un asistente amable que agenda citas...")
  recursos               Json     @default("[]")
  updatedAt              DateTime @updatedAt
  aiVoice                String   @default("Dipper")
  mensajeSaludo          String?
  aiRegion               String   @default("es-MX")
  depositoMinimo         Decimal? @db.Decimal(10, 2)
  landingColorFondo      String?  @default("#FFFFFF")
  landingColorPrimario   String?  @default("#10B981")
  landingDescripcion     String?
  landingImagenFondo     String?
  landingLogo            String?
  metodosPago            String[] @default(["prepago"])
  precioPorMinuto        Decimal  @default(0.50) @db.Decimal(10, 4)
  registrationSlug       String?  @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model Wallet {
  userId       String              @id @db.Uuid
  saldo        Decimal             @default(0) @db.Decimal(10, 4)
  moneda       String              @default("USD")
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  tipo          String
  monto         Decimal  @db.Decimal(10, 4)
  saldoAnterior Decimal  @db.Decimal(10, 4)
  saldoNuevo    Decimal  @db.Decimal(10, 4)
  whopPaymentId String?
  callSid       String?
  descripcion   String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "wallet_tx_user_fkey")
  user          Wallet   @relation(fields: [userId], references: [userId], map: "wallet_tx_user_fkey")

  @@unique([tipo, whopPaymentId])
  @@unique([tipo, callSid])
  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model AdminConfig {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@map("admin_config")
}

model BusinessMemory {
  id         Int                    @id @default(autoincrement())
  userId     String                 @db.Uuid
  rawContext String
  embedding  Unsupported("vector")?
  status     String                 @default("activo")
  version    Int                    @default(1)
  createdAt  DateTime               @default(now())

  @@index([userId, status])
  @@map("business_memory")
}

model PhoneNumber {
  id                  Int           @id @default(autoincrement())
  userId              String        @db.Uuid
  phoneNumber         String        @unique
  countryCode         String        @default("+1")
  isActive            Boolean       @default(true)
  purchasedAt         DateTime      @default(now())
  telnyxPhoneSid      String?
  currency            String        @default("USD")
  lastMonthlyChargeAt DateTime?
  monthlyCost         Decimal?      @db.Decimal(10, 4)
  upfrontCost         Decimal?      @db.Decimal(10, 4)
  releasedAt          DateTime?
  suspensionAt        DateTime?
  appointments        Appointment[]
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_numbers")
}

model Appointment {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  phoneNumberId   Int?
  customerName    String
  customerPhone   String?
  customerEmail   String?
  extraFields     Json?
  startTime       DateTime        @db.Timestamptz(6)
  endTime         DateTime?       @db.Timestamptz(6)
  durationMinutes Int?
  recursoId       String?
  status          String          @default("agendado")
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  servicio        String?
  phoneNumber     PhoneNumber?    @relation(fields: [phoneNumberId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordings      CallRecording[]

  @@index([userId, startTime])
  @@index([userId, recursoId, startTime])
  @@map("appointments")
}

model CallRecording {
  id                  Int          @id @default(autoincrement())
  userId              String       @db.Uuid
  appointmentId       String?      @db.Uuid
  r2FileUrl           String
  durationSeconds     Int?
  createdAt           DateTime     @default(now())
  telnyxCallControlId String?
  telnyxStreamSid     String?
  appointment         Appointment? @relation(fields: [appointmentId], references: [id])
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("call_recordings")
}

model CallMetric {
  id                 Int       @id @default(autoincrement())
  callSid            String?
  userId             String?   @db.Uuid
  inicio             DateTime?
  fin                DateTime?
  duracionSegundos   Int?
  latenciaPromedioMs Int?
  latenciaMaxMs      Int?
  cobroAplicado      Decimal?  @db.Decimal(10, 4)
  errorCode          String?
  createdAt          DateTime  @default(now())
  callerNumber       String?
  toNumber           String?
  user               User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("call_metrics")
}

model CallTranscript {
  id        Int      @id @default(autoincrement())
  callSid   String
  userId    String   @db.Uuid
  rol       String
  texto     String
  ts        DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([callSid])
  @@map("call_transcripts")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  tipo      String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  adminId      String   @db.Uuid
  targetUserId String?  @db.Uuid
  action       String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Affiliate {
  id                  String    @id @default(uuid()) @db.Uuid
  nombre              String
  email               String    @unique
  telefono            String?
  passwordHash        String
  slug                String    @unique
  feeInstalacion      Decimal   @db.Decimal(10, 2)
  saldoAcumulado      Decimal   @default(0) @db.Decimal(10, 4)
  totalGanado         Decimal   @default(0) @db.Decimal(10, 4)
  isActive            Boolean   @default(true)
  desactivadoAt       DateTime?
  desactivadoMotivo   String?
  createdAt           DateTime  @default(now())
  comisionPorMinuto   Decimal   @default(0.05) @db.Decimal(10, 4)
  gananciaInstalacion Decimal   @default(50) @db.Decimal(10, 2)
  referidos           User[]

  @@map("affiliates")
}

model EndCustomer {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  nombre         String
  telefono       String
  email          String?
  saldoMinutos   Decimal              @default(0) @db.Decimal(10, 2)
  saldoDinero    Decimal              @default(0) @db.Decimal(10, 4)
  createdAt      DateTime             @default(now())
  pagos          EndCustomerPayment[]
  tenant         User                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refundRequests RefundRequest[]

  @@unique([tenantId, telefono])
  @@map("end_customers")
}

model EndCustomerPayment {
  id                 String      @id @default(uuid()) @db.Uuid
  endCustomerId      String      @db.Uuid
  tenantId           String      @db.Uuid
  whopPaymentId      String      @unique
  tipo               String
  montoTotal         Decimal     @db.Decimal(10, 4)
  minutosComprados   Decimal?    @db.Decimal(10, 2)
  precioPorMinuto    Decimal     @db.Decimal(10, 4)
  comisionPlataforma Decimal     @db.Decimal(10, 4)
  comisionDueno      Decimal     @db.Decimal(10, 4)
  comisionAfiliado   Decimal?    @db.Decimal(10, 4)
  affiliateId        String?     @db.Uuid
  reembolso          Decimal?    @db.Decimal(10, 4)
  status             String      @default("activo")
  createdAt          DateTime    @default(now())
  endCustomer        EndCustomer @relation(fields: [endCustomerId], references: [id])

  @@map("end_customer_payments")
}

model RefundRequest {
  id              String      @id @default(uuid()) @db.Uuid
  endCustomerId   String      @db.Uuid
  tenantId        String      @db.Uuid
  whopPaymentId   String
  montoSolicitado Decimal     @db.Decimal(10, 4)
  status          String      @default("pendiente")
  createdAt       DateTime    @default(now())
  endCustomer     EndCustomer @relation(fields: [endCustomerId], references: [id])

  @@map("refund_requests")
}
