// ============================================================
// PLATAFORMA SAAS DE AGENTE DE VOZ IA - Schema Multi-tenant
// Adaptado de PostgreSQL+pgvector a SQLite para entorno sandbox.
// La estructura lógica respeta el spec original (secciones 4-9).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════
// 1. USUARIOS (Clientes del SaaS + Admin)
// ═══════════════════════════════════════════
model User {
  id                            String   @id @default(cuid())
  email                         String   @unique
  passwordHash                  String
  role                          String   @default("cliente") // 'cliente' | 'admin'
  isVerified                    Boolean  @default(false)
  verificationToken             String?
  recoveryToken                 String?
  isSuspended                   Boolean  @default(false)
  createdAt                     DateTime @default(now())

  // Perfil del negocio
  businessName                  String?
  businessPhone                 String?

  // Credenciales Twilio (encriptadas AES-256-GCM en prod)
  twilioSubaccountSid           String?
  twilioSubaccountAuthTokenEnc  String?

  // Relaciones
  settings                      BusinessSettings?
  wallet                        Wallet?
  transactions                  WalletTransaction[]
  phoneNumbers                  PhoneNumber[]
  appointments                  Appointment[]
  recordings                    CallRecording[]
  metrics                       CallMetric[]
  memories                      BusinessMemory[]
}

// ═══════════════════════════════════════════
// 2. CONFIGURACIÓN DEL NEGOCIO
// ═══════════════════════════════════════════
model BusinessSettings {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiLanguage            String   @default("es") // 'es','en','pt','fr', etc.
  bookingMode           String   @default("hours") // 'hours' | 'nights'
  defaultDurationMinutes Int     @default(30)
  checkInTime           String   @default("15:00")
  checkOutTime          String   @default("11:00")

  // Horarios de atención (JSON por día)
  businessHours         String   @default("{\"lunes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"martes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"miercoles\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"jueves\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"viernes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"sabado\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"14:00\"},\"domingo\":{\"abierto\":false,\"inicio\":null,\"fin\":null}}")

  modo247               Boolean  @default(false)
  timezone              String   @default("America/Mexico_City")

  grabacionActiva       Boolean  @default(false)
  mensajeConsentimiento String  @default("Esta llamada puede ser grabada para fines de calidad.")
  consentimientoActivo  Boolean  @default(false)

  // Formulario dinámico
  formFields            String   @default("[{\"key\":\"nombre\",\"label\":\"Nombre completo\",\"type\":\"text\",\"required\":true},{\"key\":\"telefono\",\"label\":\"Teléfono\",\"type\":\"tel\",\"required\":false},{\"key\":\"email\",\"label\":\"Correo electrónico\",\"type\":\"email\",\"required\":false},{\"key\":\"notas\",\"label\":\"Notas adicionales\",\"type\":\"textarea\",\"required\":false}]")

  systemPromptContext   String   @default("Eres un asistente amable que agenda citas...")

  // Recursos del negocio (barbería: sillas, clínica: doctores, hotel: habitaciones)
  recursos              String   @default("[]")

  updatedAt             DateTime @updatedAt
}

// ═══════════════════════════════════════════
// 3. WALLET / BILLING (Ledger)
// ═══════════════════════════════════════════
model Wallet {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saldo      Float    @default(0) // Saldo actual (puede ser negativo)
  moneda     String   @default("USD")
  updatedAt  DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet?  @relation(fields: [userId], references: [userId])
  tipo            String   // 'recarga' | 'debito' | 'ajuste_admin' | 'trial'
  monto           Float    // Positivo = crédito, Negativo = débito
  saldoAnterior   Float
  saldoNuevo      Float
  whopPaymentId   String?
  callSid         String?
  descripcion     String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model RechargePackage {
  id                 Int      @id @default(autoincrement())
  nombre             String
  montoRecarga       Float    // Cuánto paga el cliente
  saldoOtorgado      Float    // Cuánto saldo recibe
  precioPorMinuto    Float
  precioPorSegundo   Float?
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now())
}

// ═══════════════════════════════════════════
// 4. CONFIGURACIÓN GLOBAL DEL ADMIN
// ═══════════════════════════════════════════
model AdminConfig {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════════════════
// 5. MEMORIA / RAG
// ═══════════════════════════════════════════
model BusinessMemory {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawContext  String
  // embedding vector(768) -- en SQLite se omite el vector, se simula en capa de servicio
  status      String   @default("activo") // 'borrador' | 'activo' | 'archivado'
  version     Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════
// 6. NÚMEROS TELEFÓNICOS
// ═══════════════════════════════════════════
model PhoneNumber {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twilioPhoneSid  String?
  phoneNumber     String   @unique
  countryCode     String   @default("+1")
  isActive        Boolean  @default(true)
  purchasedAt     DateTime @default(now())

  appointments    Appointment[]

  @@index([userId])
}

// ═══════════════════════════════════════════
// 7. CITAS (Universal: horas, noches, recursos)
// ═══════════════════════════════════════════
model Appointment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumberId   Int?
  phoneNumber     PhoneNumber? @relation(fields: [phoneNumberId], references: [id])

  customerName    String
  customerPhone   String?
  customerEmail   String?
  extraFields     String?  // JSON string

  startTime       DateTime // UTC
  endTime         DateTime?
  durationMinutes Int?

  recursoId       String?
  status          String   @default("agendado") // 'agendado'|'asistio'|'no_asistio'|'cancelado'
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recordings      CallRecording[]

  @@index([userId, startTime])
  @@index([userId, recursoId])
}

// ═══════════════════════════════════════════
// 8. GRABACIONES
// ═══════════════════════════════════════════
model CallRecording {
  id              Int      @id @default(autoincrement())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  twilioCallSid   String?
  twilioStreamSid String?
  r2FileUrl       String
  durationSeconds Int?
  createdAt       DateTime @default(now())
}

// ═══════════════════════════════════════════
// 9. MÉTRICAS DE LLAMADAS (monitoreo)
// ═══════════════════════════════════════════
model CallMetric {
  id              Int      @id @default(autoincrement())
  callSid         String?
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  inicio          DateTime?
  fin             DateTime?
  duracionSegundos Int?
  latenciaPromedioMs Int?
  latenciaMaxMs   Int?
  cobroAplicado   Float?
  errorCode       String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════
// 10. NOTIFICACIONES (log de eventos SSE)
// ═══════════════════════════════════════════
model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  tipo      String   // 'nueva_cita'|'llamada_finalizada'|'saldo_bajo'|'alerta_sistema'|'transcripcion'
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
