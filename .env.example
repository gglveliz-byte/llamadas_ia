# FRONTEND — Variables públicas (se exponen al navegador)
# Copia a .env y completa

NEXT_PUBLIC_API_URL=https://tu-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://tu-backend.onrender.com

# Solo para validación en runtime (no se exponen al cliente)
JWT_SECRET=tu_jwt_secret_32_chars_minimo
INTERNAL_API_KEY=tu_internal_api_key
NODE_ENV=development