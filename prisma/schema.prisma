generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String   @id @default(uuid()) @db.Uuid
  email                         String   @unique
  passwordHash                  String
  role                          String   @default("cliente")
  isVerified                    Boolean  @default(false)
  verificationToken             String?
  recoveryToken                 String?
  resetToken                    String?
  resetTokenExpiry              DateTime?
  isSuspended                   Boolean  @default(false)
  createdAt                     DateTime @default(now())

  businessName                  String?
  businessPhone                 String?

  telnyxChildAccountId          String?
  telnyxApiKeyEncrypted         String?
  telnyxProvisioningStatus      String   @default("none")
  telnyxProvisioningError       String?

  settings                      BusinessSettings?
  wallet                        Wallet?
  transactions                  WalletTransaction[]
  phoneNumbers                  PhoneNumber[]
  appointments                  Appointment[]
  recordings                    CallRecording[]
  metrics                       CallMetric[]
  memories                      BusinessMemory[]
  transcripts                   CallTranscript[]

  @@map("users")
}

model BusinessSettings {
  userId                String   @id @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  aiLanguage            String   @default("es")
  bookingMode           String   @default("hours")
  defaultDurationMinutes Int     @default(30)
  checkInTime           String   @default("15:00")
  checkOutTime          String   @default("11:00")

  businessHours         Json     @default("{\"lunes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"martes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"miercoles\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"jueves\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"viernes\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"18:00\"},\"sabado\":{\"abierto\":true,\"inicio\":\"09:00\",\"fin\":\"14:00\"},\"domingo\":{\"abierto\":false,\"inicio\":null,\"fin\":null}}")

  modo247               Boolean  @default(false)
  timezone              String   @default("America/Mexico_City")

  grabacionActiva       Boolean  @default(false)
  mensajeConsentimiento String   @default("Esta llamada puede ser grabada para fines de calidad.")
  consentimientoActivo  Boolean  @default(false)

  formFields            Json     @default("[{\"key\":\"nombre\",\"label\":\"Nombre completo\",\"type\":\"text\",\"required\":true},{\"key\":\"telefono\",\"label\":\"Teléfono\",\"type\":\"tel\",\"required\":false},{\"key\":\"email\",\"label\":\"Correo electrónico\",\"type\":\"email\",\"required\":false},{\"key\":\"notas\",\"label\":\"Notas adicionales\",\"type\":\"textarea\",\"required\":false}]")

  systemPromptContext   String   @default("Eres un asistente amable que agenda citas...")

  recursos              Json     @default("[]")

  updatedAt             DateTime @updatedAt

  @@map("business_settings")
}

model Wallet {
  userId     String              @id @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  saldo      Decimal             @default(0) @db.Decimal(10, 4)
  moneda     String              @default("USD")
  updatedAt  DateTime            @updatedAt

  transactions WalletTransaction[]

  @@map("wallet")
}

model WalletTransaction {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "wallet_tx_user_fkey")
  wallet          Wallet?  @relation(fields: [userId], references: [userId], map: "wallet_tx_wallet_fkey")
  tipo            String
  monto           Decimal  @db.Decimal(10, 4)
  saldoAnterior   Decimal  @db.Decimal(10, 4)
  saldoNuevo      Decimal  @db.Decimal(10, 4)
  whopPaymentId   String?
  callSid         String?
  descripcion     String?
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@unique([tipo, whopPaymentId])
  @@unique([tipo, callSid])
  @@map("wallet_transactions")
}

model RechargePackage {
  id               Int      @id @default(autoincrement())
  nombre           String
  montoRecarga     Decimal  @db.Decimal(10, 2)
  saldoOtorgado    Decimal  @db.Decimal(10, 2)
  precioPorMinuto  Decimal  @db.Decimal(10, 4)
  precioPorSegundo Decimal? @db.Decimal(10, 6)
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@map("recharge_packages")
}

model AdminConfig {
  id          Int      @id @default(autoincrement())
  clave       String   @unique
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@map("admin_config")
}

model BusinessMemory {
  id          Int    @id @default(autoincrement())
  userId      String @db.Uuid
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawContext  String
  embedding   Unsupported("vector(768)")?
  status      String @default("activo")
  version     Int    @default(1)
  createdAt   DateTime @default(now())

  @@index([userId, status])
  @@map("business_memory")
}

model PhoneNumber {
  id              Int      @id @default(autoincrement())
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telnyxPhoneSid  String?
  phoneNumber     String   @unique
  countryCode     String   @default("+1")
  isActive        Boolean  @default(true)
  purchasedAt     DateTime @default(now())

  appointments    Appointment[]

  @@index([userId])
  @@map("phone_numbers")
}

model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumberId   Int?
  phoneNumber     PhoneNumber? @relation(fields: [phoneNumberId], references: [id])

  customerName    String
  customerPhone   String?
  customerEmail   String?
  extraFields     Json?

  startTime       DateTime @db.Timestamptz
  endTime         DateTime? @db.Timestamptz
  durationMinutes Int?

  recursoId       String?
  status          String   @default("agendado")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recordings      CallRecording[]

  @@index([userId, startTime])
  @@index([userId, recursoId, startTime])
  @@map("appointments")
}

model CallRecording {
  id                  Int      @id @default(autoincrement())
  userId              String   @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId       String?  @db.Uuid
  appointment         Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  telnyxCallControlId String?
  telnyxStreamSid     String?
  r2FileUrl           String
  durationSeconds     Int?
  createdAt           DateTime @default(now())

  @@map("call_recordings")
}

model CallMetric {
  id                  Int      @id @default(autoincrement())
  callSid             String?
  userId              String?  @db.Uuid
  user                User?    @relation(fields: [userId], references: [id])
  inicio              DateTime?
  fin                 DateTime?
  duracionSegundos    Int?
  latenciaPromedioMs  Int?
  latenciaMaxMs       Int?
  cobroAplicado       Decimal? @db.Decimal(10, 4)
  errorCode           String?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@map("call_metrics")
}

model CallTranscript {
  id        Int      @id @default(autoincrement())
  callSid   String
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rol       String
  texto     String
  ts        DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([callSid])
  @@map("call_transcripts")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  tipo      String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  adminId       String   @db.Uuid
  targetUserId  String?  @db.Uuid
  action        String
  details       Json?
  createdAt     DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
