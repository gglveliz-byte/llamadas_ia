# FRONTEND — Variables públicas (se exponen al navegador)
# Copia a .env y completa

NEXT_PUBLIC_API_URL=https://tu-backend.onrender.com
NEXT_PUBLIC_WS_URL=wss://tu-backend.onrender.com

# Solo para validación en runtime (no se exponen al cliente)
JWT_SECRET=tu_jwt_secret_32_chars_minimo
INTERNAL_API_KEY=tu_internal_api_key
NODE_ENV=development

# ==========================================
# BACKEND EXPRESS VARIABLES (Requeridas)
# ==========================================

# Base de datos y Caché (Valores por defecto de docker-compose)
DATABASE_URL="postgresql://vozia:vozia_dev@localhost:5432/vozia?schema=public"
REDIS_URL="redis://localhost:6379"

# APIs Externas
GEMINI_API_KEY="tu_api_key_de_google_ai_studio"
TELNYX_API_KEY="tu_api_key_de_telnyx_v2"
TELNYX_PUBLIC_KEY="tu_llave_publica_de_telnyx_ed25519"
TELNYX_WEBHOOK_SECRET=""
TELNYX_WEBHOOK_URL="http://localhost:3001/webhooks/telnyx/voice"
TELNYX_CONNECTION_ID="tu_connection_id_de_telnyx"
WHOP_API_KEY="tu_whop_api_key"
WHOP_COMPANY_ID="tu_whop_company_id"
WHOP_WEBHOOK_SECRET="tu_whop_webhook_secret"

# Cloudflare R2 (Almacenamiento)
R2_ACCOUNT_ID="tu_cloudflare_account_id"
R2_ACCESS_KEY_ID="tu_r2_access_key"
R2_SECRET_ACCESS_KEY="tu_r2_secret_key"
R2_BUCKET_NAME="vozia-grabaciones"

# Seguridad y JWT (Usa valores complejos en producción)
JWT_SECRET="vozia-dev-jwt-secret-32-chars-minimum-length"
JWT_REFRESH_SECRET="vozia-dev-refresh-secret-32-chars-minimum-length"
ENCRYPTION_KEY="vozia-dev-key-de-64-caracteres-hexadecimales-minimo-para-seguridad"

# Correos (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_app_password"

# Dominios Backend
DOMINIO_FRONTEND="http://localhost:3000"
DOMINIO_EXPRESS="http://localhost:3001"