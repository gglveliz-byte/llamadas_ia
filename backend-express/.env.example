# BACKEND — Variables privadas (NO se exponen al navegador)
# Copia a backend-express/.env y completa con TUS valores reales

# ─── Base de Datos ───
DATABASE_URL=postgresql://usuario:pass@host:5432/db?sslmode=require

# ─── Redis ───
REDIS_URL=redis://default:pass@host:6379

# ─── Gemini ───
GEMINI_API_KEY=tu_gemini_api_key

# ─── Telnyx (REEMPLAZA TODO) ───
TELNYX_API_KEY=tu_telnyx_api_key
TELNYX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nTU_PUBLIC_KEY_PEM_AQUI\n-----END PUBLIC KEY-----
TELNYX_ORG_ID=tu_org_id_real
TELNYX_CONNECTION_ID=tu_connection_id_real
TELNYX_WEBHOOK_SECRET=tu_webhook_secret

# ─── Whop ───
WHOP_API_KEY=tu_whop_api_key
WHOP_WEBHOOK_SECRET=tu_whop_webhook_secret

# ─── Cloudflare R2 ───
R2_ACCOUNT_ID=tu_r2_account_id
R2_BUCKET_NAME=tu_bucket
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key

# ─── Auth / Secrets (genera en prod: openssl rand -base64 32 / -hex 32) ───
JWT_SECRET=tu_jwt_secret_32_chars_minimo
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_32_chars_minimo
ENCRYPTION_KEY=tu_encryption_key_64_hex_chars
INTERNAL_API_KEY=tu_internal_api_key

# ─── Email ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password

# ─── Dominios ───
DOMINIO_FRONTEND=https://tu-frontend.onrender.com
DOMINIO_EXPRESS=https://tu-backend.onrender.com

# ─── Runtime ───
NODE_ENV=development
LOG_LEVEL=debug